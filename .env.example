# ── Azure OpenAI
# AZURE_OPENAI_ENDPOINT 填基底 URL（只含 scheme+host），不含路徑：
#   https://<your-resource>.openai.azure.com/
#   https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o                        # 對話模型的部署名稱
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large   # embedding 模型的部署名稱

# ── LangSmith（LLM 監控，選填）
# 官網：https://smith.langchain.com/
# 不填則靜默略過，不影響系統運作
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ncu-rag-system
LANGSMITH_TRACING=true

# -----------------------------------
# 應用程式設定（保留預設即可）
# -----------------------------------
APP_ENV=development
APP_PORT=8000
DATA_DIR=data
COURSE_JSON_PATH=data/processed/courses.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# -----------------------------------
# Cloudinary（上傳 PDF 用）
# -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PROJECT_FOLDER=ncu-ai-guidance/data/raw/projects

# PostgreSQL
DATABASE_URL=

# 開發人員 email（/monitor 監控頁面存取控制，多個用逗號分隔）
DEVELOPER_EMAILS=

# Qdrant（向量資料庫）
# 本機開發可留空，會使用 data/processed/qdrant_data。
# 部署到雲端時填 Qdrant Cloud URL / API key。
QDRANT_URL=
QDRANT_API_KEY=

# Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# -----------------------------------
# PDF Chat（Multi-agent 問答）
# -----------------------------------
# PDF chunk 在 Qdrant 的 collection 名稱
PDF_QDRANT_COLLECTION=reports

# Azure 模型部署名稱（PDF 問答使用；若與上方同名可留空由 pdf_config.py 讀取預設值）
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# LangSmith（PDF 問答獨立 project，與課程助手分開追蹤）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=        # 同 LANGSMITH_API_KEY
LANGCHAIN_PROJECT=ncu-pdf-chat
