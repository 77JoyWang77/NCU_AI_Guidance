{
  "id": "cbp_engineering",
  "name": "工學院學士班",
  "program_type": "college_bachelor",
  "min_credits": 128,
  "college_required_credits": 36,
  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 128,
      "description": "最低畢業學分 128 學分"
    },
    {
      "type": "college_required",
      "credits": 36,
      "description": "院必修 36 學分（含倫理課程五選一 2 學分）"
    },
    {
      "type": "specialization_track",
      "tracks_min": 1,
      "description": "必須從智慧機械/能源材料/永續防災/綠色科技四個專長領域選擇其一為主修領域"
    },
    {
      "type": "secondary_track_optional",
      "description": "可依「輔修領域修習辦法」選第二領域為輔修（必修9學分＋選修6學分＝15學分，加註於畢業證書）"
    },
    {
      "type": "design_thinking",
      "credits": 2,
      "description": "其他選修須必選設計思考相關課程至少 2 學分（指定5門中選一）"
    },
    {
      "type": "social_practice_prerequisite",
      "description": "社會實踐專題II EI3104 需先修畢社會實踐專題I EI3103；修畢跨領域社會參與/社會企業學分學程者得免修"
    },
    {
      "type": "general_education_required",
      "description": "通識課程必修「社會參與之導航與探索 CC0424」"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文課程三種方式擇一修習 6 學分"
    },
    {
      "type": "general_education",
      "credits": 14,
      "domains_min": 1,
      "description": "通識課程 14 學分，核心必修四大領域至少修習一個領域"
    }
  ],
