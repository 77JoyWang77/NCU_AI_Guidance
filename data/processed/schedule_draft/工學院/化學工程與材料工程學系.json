{
  "id": "dept_chemical_materials_engineering",
  "name": "化學工程與材料工程學系",
  "program_type": "traditional_dept",
  "min_credits": 128,
  "required_credits": 112,
  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 128,
      "description": "最低畢業學分 128 學分"
    },
    {
      "type": "dept_required",
      "credits": 112,
      "description": "必修科目 112 學分（含院系訂必修、核心必選修、專題必選修）"
    },
    {
      "type": "free_elective_min",
      "credits": 16,
      "description": "選修科目至少 16 學分"
    },
    {
      "type": "ch_elective_min",
      "credits": 6,
      "description": "選修學分中至少 6 學分須為本系(CH)或工學院C類課群所涵蓋之相關課程"
    },
    {
      "type": "core_elective_ab",
      "groups": [
        "A",
        "B"
      ],
      "each_min": 1,
      "description": "核心必選修 A、B 兩組各至少選修 1 門並及格"
    },
    {
      "type": "capstone_elective_min",
      "courses_min": 1,
      "description": "專題必選修至少選修 1 門並及格"
    },
    {
      "type": "prerequisite_calculus_to_engineering_math",
      "description": "通過微積分(MA1003或MA1004)任一門，方可修習工程數學(CH2009/CH2010)"
    },
    {
      "type": "capstone_mutual_exclusion",
      "description": "同一學期不可同時修讀專題製作(CH3063)與學士論文(CH4071/CH4072)"
    },
    {
      "type": "prerequisite_thesis",
      "description": "修畢學士論文I(CH4071)方可修習學士論文II(CH4072)"
    },
    {
      "type": "prerequisite_project_sequence",
      "description": "理論與實務整合專題實作需依 EG3001→EG3002→EG3003 順序修習"
    },
    {
      "type": "prerequisite_program_design",
      "description": "修習程序設計(CH4042)需先通過 CH1012/CH3043/CH3059/CH3011 四門中任兩門以上"
    },
    {
      "type": "general_education",
      "credits": 14,
      "domains_min": 1,
      "description": "通識核心必修：人文與思想、自然科學、社會思潮與現象三大領域至少修習一個"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文三種方式擇一修習 6 學分（第二外語亦可）"
    }
  ],
