    {
      "type": "credit_minimum",
      "credits": 132,
      "description": "最低畢業學分數 132 學分"
    },
    {
      "type": "dept_required",
      "description": "系訂必修課程須全部修畢"
    },
    {
      "type": "star_elective_min",
      "credits": 18,
      "categories_min": 3,
      "description": "「★」課程至少選修 18 學分，且跨至少 3 個類別（智慧系統、電波、電子、電通訊、資通訊）"
    },
    {
      "type": "triangle_elective_min",
      "credits": 9,
      "categories_min": 3,
      "description": "「△」實驗課程至少選修 9 學分，且跨至少 3 個類別"
    },
    {
      "type": "dept_school_elective_min",
      "credits": 12,
      "description": "本系或資電學院課程至少選修 12 學分（不含已計入★與△之學分）"
    },
    {
      "type": "capstone_credit_limit",
      "credits_max": 6,
      "courses": [
        "EE4004",
        "EE4023",
        "EE3045"
      ],
      "description": "EE4004/EE4023/EE3045 等專題類課程合計最多抵 6 學分畢業學分"
    },
    {
      "type": "equivalent_course_note",
      "description": "依本院各系等同課程對照表，等同課程重複修讀者不列入畢業學分"
    },
    {
      "type": "early_graduation",
      "rank_top_pct": 20,
      "gpa_min": 75,
      "description": "學業成績排名前 20%、平均 75 分以上者，可申請提前一學期或一學年畢業"
    },
    {
      "type": "academic_ethics_course",
      "credits": 0,
      "description": "修習畢業專題課程當學期須至「臺灣學術倫理教育資源中心」線上平台修習「學術倫理教育課程」（0學分），並通過線上課程測驗達及格標準"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文課程一律必修「大一英文」工程課群 6 學分；進修英文學分不列入畢業學分"
    }
