{
  "id": "dept_communication_engineering",
  "name": "通訊工程學系",
  "program_type": "traditional_dept",
  "min_credits": 132,
  "required_credits": 83,
  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 132,
      "description": "最低畢業學分 132 學分"
    },
    {
      "type": "dept_required",
      "credits": 83,
      "description": "共同必修 25 學分＋系訂必修 58 學分"
    },
    {
      "type": "specialization_track",
      "tracks_min": 1,
      "credits": 15,
      "description": "A組（電通訊組）或 B組（資通訊組）擇一修畢：含三門必修及任二門多選二課程，共 15 學分；超修學分可認列為選修"
    },
    {
      "type": "star_elective_min",
      "credits": 12,
      "categories_min": 2,
      "description": "由電機、通訊課程流程中具有「*」記號課程選修 12 學分，且須至少跨二類別"
    },
    {
      "type": "triangle_elective_min",
      "credits": 9,
      "description": "由電機、通訊課程流程中具有「△」記號實驗課程選修 9 學分，且須跨電通訊與資通訊兩組類別"
    },
    {
      "type": "equivalent_courses",
      "description": "依據「中央大學資電學院各系等同課程對照表」，等同課程科目重複修讀者，不列入畢業學分數"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文課程可修大一英文工程課群 6 學分，或英文系之其他英文課程；進修英文學分不列入畢業學分"
    },
    {
      "type": "early_graduation",
      "rank_top_pct": 20,
      "gpa_min": 85,
      "description": "學業總平均成績名次在本系該年級學生數前 20% 以內，或學業總平均成績在 85 分以上者，可申請提前畢業"
    }
  ],
