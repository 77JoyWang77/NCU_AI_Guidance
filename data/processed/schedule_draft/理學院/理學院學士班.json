{
  "id": "cbp_science",
  "name": "理學院學士班",
  "program_type": "college_bachelor",
  "min_credits": 128,
  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 128,
      "description": "最低畢業學分 128 學分"
    },
    {
      "type": "basic_science_two_of_three_groups",
      "credits": 12,
      "description": "班訂必修基礎科學三擇二組（每組6學分，共12學分）：普通物理A(PH1031/PH1032)、普通化學I/II(CM1009/CM1010)、普通生物學(LS1013/LS1014)，任選二組修習通過"
    },
    {
      "type": "lab_one_of_three",
      "credits": 1,
      "description": "班訂必修實驗三擇一（1學分）：普物實驗(PH1003)、普化實驗(CM1008)、普通生物學實驗(LS1003)，任選一修習通過"
    },
    {
      "type": "first_domain_minimum",
      "credits": 32,
      "credits_max": 33,
      "description": "第一領域專長之必修與選修學分須達至少 32–33 學分（化學領域必修 27–29 學分）"
    },
    {
      "type": "second_domain_minimum",
      "credits": 20,
      "description": "第二領域專長之必修與選修學分須達至少 20 學分"
    },
    {
      "type": "cross_college_elective",
      "credits": 6,
      "description": "班訂跨院選修至少 6 學分，須從管理學院、工學院、資電學院、地球科學院中擇一學院提供之課程修習"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文課程三種方式擇一：(1)大一英文科學課群6學分；(2)英文系其他英文課程修滿6學分；(3)語言中心第二外語同一語言修滿6學分"
    },
    {
      "type": "emi_track_requirement",
      "description": "修讀英文組者：①班訂必修EMI課程（微積分上下；普物/普化/普生三擇二組）；②大二至大三四個學期累積通過四門EMI課程；③第一領域必修至少24學分，第二領域必修至少12–16學分"
    }
  ],
