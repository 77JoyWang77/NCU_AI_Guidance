  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 128,
      "description": "最低畢業學分數 128 學分"
    },
    {
      "type": "dept_required",
      "credits": 85,
      "description": "必修科目共 85 學分（共同必修25＋院訂必修24＋系訂必修27＋系訂必選9）"
    },
    {
      "type": "dept_elective_min",
      "credits": 23,
      "description": "本系選修至少 23 學分"
    },
    {
      "type": "digital_literacy",
      "credits": 6,
      "description": "管院「數位素養」必選課程至少 6 學分，來源：企業資源規劃學程、商業智慧與分析學程（非EC前綴）、金融科技學程（IM前綴）或系課程委員會核准課程"
    },
    {
      "type": "general_education",
      "domains_min": 3,
      "description": "通識核心必修四大領域中任選三大領域修習，每領域至少一門課；經濟學相關課程一律不計入通識學分（清單請至系辦查詢）"
    },
    {
      "type": "general_education_limit",
      "credits_max": 6,
      "description": "除校定通識學分外，通識學分至多再認列 6 學分計入最低畢業學分"
    },
    {
      "type": "foreign_language",
      "credits": 6,
      "description": "外文一律必修「大一英文」管理課群 6 學分；進修英文學分不列入畢業學分"
    }
  ],
