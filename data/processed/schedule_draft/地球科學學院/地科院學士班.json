{
  "id": "cbp_earth_sciences",
  "name": "地科院學士班",
  "program_type": "college_bachelor",
  "min_credits": 128,
  "graduation_rules": [
    {
      "type": "credit_minimum",
      "credits": 128,
      "description": "最低畢業學分 128 學分（院訂必修12＋科學能力必修課群25＋地球系統必修課群16＋跨域知識技能課群50）"
    },
    {
      "type": "college_required",
      "credits": 12,
      "description": "院訂必修 12 學分：微積分上下（MA1003/MA1004）各3學分、普通物理A上下（PH1031/PH1032）各3學分"
    },
    {
      "type": "science_ability_required",
      "credits": 25,
      "description": "科學能力必修課群 25 學分，三類各至少修習一門：數學課程、電腦與程式語言課程、物理與化學課程。末列於附表之課程可申請認定"
    },
    {
      "type": "earth_system_required",
      "credits": 16,
      "description": "地球系統必修課群任選 16 學分；修業期間內必須通過地球系統科學概論（2學分）"
    },
    {
      "type": "cross_domain_required",
      "credits": 10,
      "description": "跨域知識技能課群必修 10 學分：地球系統科學研究專題導論GA1001（1學分）＋研究群專題任選一門（2學分）＋研究計畫寫作GA2002（1學分）＋專題研究I/II/III/IV任選三門（6學分）"
    },
    {
      "type": "cross_domain_elective",
      "credits": 40,
      "description": "跨域知識技能課群選修 40 學分，修習四大領域中至少一個領域"
    }
  ],
