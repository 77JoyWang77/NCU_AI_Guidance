    {
      "type": "core_elective_each_group",
      "credits_min": 7,
      "groups": 3,
      "description": "系訂核心選修三組（分析數學與物理、地質、水文與海洋）各選一門，合計至少 7 學分"
    },
    {
      "type": "dept_elective_gp",
